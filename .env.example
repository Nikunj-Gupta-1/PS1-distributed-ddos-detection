# Distributed DDoS Detection System Configuration

# ML Server Configuration (Cloud or Central Server)
ML_API_URL=http://your-ml-server.com:8000/predict
# For local testing: http://localhost:8000/predict
# For cloud deployment: https://your-cloud-ml-api.com/predict

# Kafka Configuration (Central Server)
# Single server deployment:
KAFKA_BOOTSTRAP_SERVERS=192.168.1.100:9092
# Multi-server deployment:
# KAFKA_BOOTSTRAP_SERVERS=192.168.1.100:9092,192.168.1.101:9092,192.168.1.102:9092
# Local testing:
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

KAFKA_TOPIC=raw_packets
KAFKA_GROUP_ID=ddos-detection-job-server

# Job Server Configuration (Central Server)
JOB_SERVER_WORKERS=4
QUEUE_SIZE=10000
FLOW_TIMEOUT=60

# Packet Detector Configuration (Multiple Devices)
PACKET_DETECTOR_INTERFACE=auto
PACKET_DETECTOR_DEVICE_ID=auto

# Logging
LOG_LEVEL=INFO

# Network Deployment Notes:
# 
# 1. Packet Capture Devices (Multiple):
#    - Set KAFKA_BOOTSTRAP_SERVERS to point to central Kafka server
#    - Each device will auto-generate unique PACKET_DETECTOR_DEVICE_ID
#    - Run: python main.py --kafka-servers 192.168.1.100:9092
#
# 2. Central Job Server (Single):
#    - Set KAFKA_BOOTSTRAP_SERVERS to local Kafka instance
#    - Set ML_API_URL to cloud ML server
#    - Run job server to process packets from all devices
#
# 3. ML Server (Cloud or Central):
#    - Can be hosted on cloud (AWS, GCP, Azure)
#    - Or on the same machine as job server
#    - Provides REST API for predictions
